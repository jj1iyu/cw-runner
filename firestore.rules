rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ランキング：誰でも読める。書けるのは自分の行だけ。
    match /scores/{uid} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['call', 'runs', 'plays', 'updatedAt'])
        && request.resource.data.call is string
        && request.resource.data.call.size() <= 12
        && request.resource.data.runs is map
        && request.resource.data.runs.size() <= 32;
    }
  }
}
