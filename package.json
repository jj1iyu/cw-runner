{
  "name": "ja-cw-runner",
  "private": true,
  "type": "module",
  "description": "スマホでもPCでも遊べるCWコンテスト練習シミュレータ（ALL JA／DX）",
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-cw-runner \"node --test tests/rules/*.test.mjs\"",
    "test:e2e": "node tools/build.mjs && node --test --test-concurrency=1 --test-timeout=60000 --test-force-exit \"tests/e2e/*.test.mjs\"",
    "test:all": "npm test && npm run test:rules && npm run test:e2e",
    "format": "prettier --write \"src/**/*.{js,css}\" \"tools/**/*.mjs\" \"tests/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{js,css}\" \"tools/**/*.mjs\" \"tests/**/*.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "esbuild": "^0.24.0",
    "firebase": "^11.0.0",
    "firebase-tools": "^13.24.0",
    "playwright": "^1.48.0",
    "prettier": "^3.3.3"
  }
}
